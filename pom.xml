<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.enterprise.storage</groupId>
    <artifactId>lsm-enterprise-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>lsm-enterprise-engine</name>
    <description>Production-grade LSM Tree Enterprise Storage Engine with native bindings</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.1</junit.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- JMH for Benchmarking -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 for Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Surefire Plugin for Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>

            <!-- AntRun Plugin to provide working targets: all, build, test, clean, benchmark -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Target: all -->
                    <execution>
                        <id>all</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Executing target: all"/>
                                <antcall target="native-compile"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- Target: build -->
                    <execution>
                        <id>build</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Executing target: build"/>
                                <antcall target="native-compile"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- Target: test -->
                    <execution>
                        <id>test-target</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Executing target: test"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- Target: clean -->
                    <execution>
                        <id>clean-target</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Executing target: clean"/>
                                <delete includeemptydirs="true" quiet="true">
                                    <fileset dir="${project.basedir}/src/main/native/build" includes="**/*"/>
                                </delete>
                            </target>
                        </configuration>
                    </execution>

                    <!-- Target: benchmark -->
                    <execution>
                        <id>benchmark</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Executing target: benchmark"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>

                <configuration>
                    <exportAntProperties>true</exportAntProperties>
                    <target>
                        <!-- Internal safe native compilation task with -O3, -Wall, -Wextra -->
                        <target name="native-compile">
                            <mkdir dir="${project.basedir}/src/main/native/build"/>
                            <available file="${project.basedir}/src/main/native" type="dir" property="native.dir.exists"/>
                            <condition property="has.source.files">
                                <and>
                                    <isset property="native.dir.exists"/>
                                    <resourcecount>
                                        <fileset dir="${project.basedir}/src/main/native" includes="*.cpp, *.cc, *.c"/>
                                    </resourcecount>
                                </and>
                            </condition>

                            <if>
                                <isset property="has.source.files"/>
                                <then>
                                    <echo message="Compiling native components with -O3, -Wall, -Wextra..."/>
                                    <!-- Generic placeholder for GCC/Clang optimization flags execution -->
                                    <exec executable="make" dir="${project.